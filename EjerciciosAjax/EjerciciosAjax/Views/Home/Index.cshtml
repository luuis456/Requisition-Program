        /* HACIENDO USO DEL FROMBODY */
        
        //// PARAMETROS SUELTOS EN FORMATO JSON, SE REQUIERE DE FROMBODY EN EL CONTROALDO Y CAMBIAR EL TIPO  
        
        $(document).ready(function(){
            
            @*
            $("#saveData").click(() => {

                var json = {
                    Nombre: $("#nombre").val(),
                    Edad: $("#edad").val(),
                };

                $.ajax({
                    url:"Home/BasicFormUsingFromBody",
                    type:"POST",
                    contentType: "application/json",
                    data: JSON.stringify(json),
                    success: function(data){
                        console.log(data);
                    },error : function(data){
