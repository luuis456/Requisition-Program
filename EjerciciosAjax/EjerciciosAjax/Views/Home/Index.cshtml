    <input type="text" name="Nombre" id="nombre">
    <input type="number" name="Edad" id="edad">
        
        <button type="button" id="saveData">Enviar</button>

    
    <hr/> 
    <hr/> 
    <hr/> 
    <hr/> 
    <hr/> 
    <hr/> 
    
    <div>

        <input type="text"
               id="txtNombre"
               placeholder="Nombre">

        <select id="cmbDepartamento">

            <option value="">Todos</option>
            <option value="Sistemas">Sistemas</option>
            <option value="Ventas">Ventas</option>

        </select>

        <label>
            <input type="checkbox"
                   id="chkActivo"
                   checked>
            Activos
        </label>

        <button id="btnBuscar" type="button">
            Buscar
        </button>

    </div>

    <br>

    <table id="tablaUsuarios" class="display">

        <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Departamento</th>
            <th>Activo</th>
            <th>Acciones</th>
        </tr>
        </thead>

    </table>
    
    
</div>


