                const tabla = $("#tablaUsuarios").DataTable({

                    ajax: {

                        url: "/Home/ObtenerUsuarios",

                        type: "POST",

                        data: function (d) {

                            d.nombre =
                                $("#txtNombre").val();

                            d.departamento =
                                $("#cmbDepartamento").val();

                            d.activo =
                                $("#chkActivo").is(":checked");

                        },

                        dataSrc: function (respuesta) {

                            console.log(respuesta);

                            // Validamos la respuesta

                            if (!respuesta.success) {

                                alert(respuesta.mensaje);

                                return [];

                            }

                            // Validamos que data exista

                            if (!Array.isArray(respuesta.data)) {

                                console.error(
                                    "La propiedad data no es un arreglo"
                                );

                                return [];

                            }

                            // Todo correcto

                            return respuesta.data;
                        }

                    },

                    columns: [

                        {
                            data: "id"
                        },

                        {
                            data: "nombre"
                        },

                        {
                            data: "departamento"
                        },

                        {
                            data: "activo",

                            render: function (data) {

                                return data
                                    ? "Sí"
                                    : "No";
                            }
                        },

                        {
                            data: null,

                            render: function (data) {
                                return `
                        <button
                            class="btnEliminar"
                            data-id="${data.id}">
                            Eliminar
                        </button>
                    `;
                            }
                        }

                    ]

                });

            $("#btnBuscar").click(() => {

                tabla.ajax.reload();

            });
            

        });
        
        


        
       
         
        
       
    
    </script>
}
