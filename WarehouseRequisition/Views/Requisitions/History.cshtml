@model RequisitionListViewModel
@{
    ViewData["ActiveSection"] = "history";
}

<div class="page-heading mb-4">
    <h2 class="mb-1">Historial</h2>
    <p class="text-secondary mb-0">Requisiciones surtidas, cerradas o canceladas. Nunca se eliminan automáticamente.</p>
</div>

<div class="app-card mb-4">
    <div class="app-card-body">
        <form method="get" class="filter-toolbar" role="search">
            <div class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label small fw-semibold">Buscar requisición...</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" name="SearchTerm" value="@Model.Filter.SearchTerm"
                               placeholder="Número, requisitor o parte" />
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-semibold">Estatus</label>
                    <select class="form-select" name="Status">
                        <option value="all-terminal" selected="@(Model.Filter.Status == "all-terminal")">Todas</option>
                        <option value="2" selected="@(Model.Filter.Status == "2")">Surtida</option>
                        <option value="3" selected="@(Model.Filter.Status == "3")">Surtida parcialmente</option>
                        <option value="4" selected="@(Model.Filter.Status == "4")">Cerrada</option>
                        <option value="5" selected="@(Model.Filter.Status == "5")">Cancelada</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-semibold">Desde</label>
                    <input type="date" class="form-control" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-semibold">Hasta</label>
                    <input type="date" class="form-control" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-semibold">Requisitor</label>
                    <input type="text" class="form-control" name="Requester" value="@Model.Filter.Requester" placeholder="Nombre..." />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-semibold">Planta</label>
                    <select class="form-select" name="PlantId">
                        <option value="">Todas</option>
                        @foreach (var plant in Model.Plants)
                        {
                            <option value="@plant.Id" selected="@(Model.Filter.PlantId == plant.Id)">@plant.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-semibold">Ordenar por</label>
                    <select class="form-select" name="Sort">
                        <option value="date_desc" selected="@(Model.Filter.Sort == "date_desc")">Más recientes</option>
                        <option value="date_asc" selected="@(Model.Filter.Sort == "date_asc")">Más antiguas</option>
                        <option value="number_asc" selected="@(Model.Filter.Sort == "number_asc")">Número (A-Z)</option>
                        <option value="number_desc" selected="@(Model.Filter.Sort == "number_desc")">Número (Z-A)</option>
                    </select>
                </div>
                <div class="col-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                    <a asp-action="History" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="app-card">
    <div class="app-card-header">
        <div>
            <h5 class="mb-0"><i class="bi bi-archive me-2 text-primary"></i>Requisiciones finalizadas</h5>
            <span class="text-secondary small">@Model.Requisitions.Count resultado(s)</span>
        </div>
    </div>
    <div class="app-card-body p-0">
        @if (Model.Requisitions.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateViewModel { Icon = "bi-clock-history", Title = "No hay requisiciones en el historial.", Description = "Las requisiciones finalizadas aparecerán aquí." }' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table req-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Fecha</th>
                            <th>Requisitor</th>
                            <th>Área</th>
                            <th>Estatus</th>
                            <th>Fecha de cierre</th>
                            <th>Surtió</th>
                            <th>Materiales</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requisition in Model.Requisitions)
                        {
                            <tr>
                                <td data-label="Número">
                                    <button type="button" class="req-number fw-semibold border-0 bg-transparent p-0"
                                            data-load-details="@requisition.Id" title="Ver detalles">
                                        @requisition.RequisitionNumber
                                    </button>
                                </td>
                                <td data-label="Fecha">@requisition.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Requisitor">@requisition.RequesterName</td>
                                <td data-label="Área">@requisition.AreaName</td>
                                <td data-label="Estatus"><partial name="_StatusBadge" model="requisition.Status" /></td>
                                <td data-label="Fecha de cierre">@requisition.ClosedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Surtió">@(!string.IsNullOrWhiteSpace(requisition.ClosedByName) ? requisition.ClosedByName : "-")</td>
                                <td data-label="Materiales" class="text-center">
                                    <span class="items-chip">@requisition.TotalItems</span>
                                    @if (requisition.ShortageCount > 0)
                                    {
                                        <span class="shortage-chip" title="Materiales con faltante">
                                            <i class="bi bi-exclamation-triangle me-1"></i>@requisition.ShortageCount
                                        </span>
                                    }
                                </td>
                                <td data-label="Acciones">
                                    <div class="d-inline-flex justify-content-end">
                                        <button type="button" class="btn btn-icon btn-soft-primary" data-load-details="@requisition.Id"
                                                title="Ver detalles" aria-label="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="modal fade details-modal" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="detailsModalContent"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/requisitions.js" asp-append-version="true"></script>
}
