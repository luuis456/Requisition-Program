<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#101828" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} · " : "")Sistema de Requisiciones de Almacén</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-wrapper">
        <aside class="app-sidebar d-none d-lg-flex">
            <partial name="_Sidebar" />
        </aside>

        <div class="offcanvas offcanvas-start app-sidebar-offcanvas" tabindex="-1" id="mobileSidebar" aria-label="Navegación principal">
            <div class="offcanvas-body app-sidebar d-flex d-lg-none">
                <partial name="_Sidebar" />
            </div>
        </div>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left d-flex align-items-center gap-3">
                    <button class="btn btn-icon d-lg-none" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar"
                            aria-controls="mobileSidebar" aria-label="Abrir navegación">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h1 class="topbar-title mb-0">@ViewData["Title"]</h1>
                    </div>
                </div>
                <div class="topbar-right d-flex align-items-center gap-2 gap-md-3">
                    <span class="topbar-date d-none d-sm-inline-flex align-items-center gap-2">
                        <i class="bi bi-calendar3"></i>
                        @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")
                    </span>
                    <a asp-controller="Requisitions" asp-action="Create" class="btn btn-primary btn-sm rounded-pill topbar-cta">
                        <i class="bi bi-plus-lg"></i><span class="d-none d-md-inline ms-1">Nueva requisición</span><span class="d-md-none ms-1">Nueva</span>
                    </a>
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_Toast" />
    <partial name="_ConfirmDialog" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
