<div class="modal fade confirm-modal" id="appConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center">
            <div class="modal-body pt-4 pb-4 px-4">
                <div class="confirm-icon mb-3 mx-auto">
                    <i class="bi bi-question-lg"></i>
                </div>
                <h5 class="mb-1 fw-bold" id="appConfirmTitle">¿Estás seguro?</h5>
                <p class="text-secondary small mb-4" id="appConfirmMessage"></p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-fill rounded-pill"
                            data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger flex-fill rounded-pill"
                            id="appConfirmAccept">Sí, continuar</button>
                </div>
            </div>
        </div>
    </div>
</div>
